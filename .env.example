WA_PHONE_NUMBER=
OWNER_NUMBERS=
PREFIX=!

# Ignore messages that were created before the current WhatsApp connection started.
# Set false if you want the bot to process offline/backlog messages after reconnect.
IGNORE_OFFLINE_MESSAGES=true

WA_AUTH_DIR=/storage/1FC3-111D/whatsapp-auth
BOT_DATA_DIR=/storage/1FC3-111D/discord

DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_WA_TARGET=
DISCORD_WEBHOOK_URL=
DISCORD_ALLOWED_USER_IDS=

DEV_ALLOWED_COMMANDS=python
DEV_ALLOWED_SCRIPTS=
DEV_TIMEOUT_MS=15000
DEV_MAX_OUTPUT=12000

# Optional Telegram text-file round trip for the !tg WhatsApp command.
TELEGRAM_ENABLED=false
TG_API_ID=
TG_API_HASH=
TG_SESSION_FILE=~/telegram/data/session.txt
# Telegram processor bot/chat. Falls back to TG_DOWNLOAD_BOT if set.
TG_PROCESSOR_CHAT=
# Per-file byte limit (default 15 MiB) and response timeout.
TG_MAX_FILE_BYTES=15728640
TG_TIMEOUT_MS=300000
